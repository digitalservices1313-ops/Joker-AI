<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0E">

    <!-- Top Bar: Menu + Greeting + Avatar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/btnMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☰"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:paddingEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Joker AI"
                android:textColor="#FF0033"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Good afternoon, Boss"
                android:textColor="#777788"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivHeaderLogo"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/joker_logo"
            android:scaleType="fitCenter"
            android:contentDescription="Avatar" />
    </LinearLayout>

    <!-- Main Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:layout_above="@+id/bottomDock"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="16dp">

            <!-- 3D Fluid Red Particle Orb -->
            <com.joker.ai.JokerOrbView
                android:id="@+id/jokerOrb"
                android:layout_width="230dp"
                android:layout_height="230dp"
                android:layout_marginTop="6dp" />

            <!-- Video 1 Style: Pill Status Badge -->
            <TextView
                android:id="@+id/tvOrbStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#1C0A10"
                android:paddingHorizontal="14dp"
                android:paddingVertical="5dp"
                android:text="● STANDBY // READY FOR COMMANDS"
                android:textColor="#FF3355"
                android:textSize="11sp"
                android:letterSpacing="0.04"
                android:textStyle="bold" />

            <!-- Video 1 Style: Weather / System Diagnostic Card -->
            <LinearLayout
                android:id="@+id/cardDiagnostics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="#121218"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvWeatherTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="32°C"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clear Sky // Neural Engine Online"
                        android:textColor="#DDDDDD"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Memory: Active | Cloud Link: 99.8%"
                        android:textColor="#777788"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☀️"
                    android:textSize="22sp" />
            </LinearLayout>

            <!-- Video 1 Style: 3 Quick Action Pills -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/btnScreen"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="#15151F"
                    android:gravity="center"
                    android:paddingVertical="9dp"
                    android:text="📱 Screen"
                    android:textColor="#DDDDDD"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnMemory"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:background="#15151F"
                    android:gravity="center"
                    android:paddingVertical="9dp"
                    android:text="🧠 Memories"
                    android:textColor="#DDDDDD"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnLanguage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="#15151F"
                    android:gravity="center"
                    android:paddingVertical="9dp"
                    android:text="🌐 Language"
                    android:textColor="#DDDDDD"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Chat Transcript Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:background="#101016"
                android:orientation="vertical"
                android:padding="10dp">

                <ScrollView
                    android:id="@+id/scrollView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true">

                    <TextView
                        android:id="@+id/tvChat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Joker AI: Online and Ready for commands.\n"
                        android:textColor="#CCCCCC"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp" />
                </ScrollView>
            </LinearLayout>

            <!-- Quick Text Input Bar (Typing support) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/etMessage"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:hint="Type or tap center mic..."
                    android:textColorHint="#666677"
                    android:textColor="#FFFFFF"
                    android:background="#14141E"
                    android:paddingHorizontal="12dp"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnSend"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:text="SEND"
                    android:backgroundTint="#FF0033"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Video 1 Style: Bottom Navigation Dock with Center Big Elevated Mic -->
    <LinearLayout
        android:id="@+id/bottomDock"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="#0E0E14"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp">

        <!-- 1. Home -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏠"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="#FF0033"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2. Chat -->
        <LinearLayout
            android:id="@+id/navChat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💬"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chat"
                android:textColor="#888899"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 3. CENTER BIG ELEVATED RED MIC BUTTON (Video 1 Exact Style) -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingHorizontal="6dp">

            <ImageButton
                android:id="@+id/btnMic"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:backgroundTint="#FF0033"
                android:src="@drawable/ic_mic"
                android:scaleType="centerInside"
                android:contentDescription="Center Mic" />
        </FrameLayout>

        <!-- 4. Settings -->
        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Setting"
                android:textColor="#888899"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 5. Updates -->
        <LinearLayout
            android:id="@+id/navUpdates"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔄"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Updates"
                android:textColor="#888899"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
