<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0D11"
    android:padding="16dp">

    <!-- Header: Compact Joker Logo + Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/ivHeaderLogo"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/joker_logo"
            android:scaleType="fitCenter"
            android:contentDescription="Joker Logo" />

        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Joker AI Agent"
            android:textColor="#FF1E44"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Chat Display Area -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <TextView
            android:id="@+id/tvChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Joker AI: Online and Ready. Tap Mic to speak!\n"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp" />
    </ScrollView>

    <!-- Message Input Box, Mic Button and Send Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp">

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Type or tap mic..."
            android:textColorHint="#777777"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF1E44"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnMic"
            android:layout_width="54dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="🎙️"
            android:textSize="18sp"
            android:backgroundTint="#220D15"
            android:textColor="#FF1E44" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Send"
            android:backgroundTint="#FF1E44"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
