<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#070709"
    android:padding="16dp">

    <!-- Top Header: Logo + Futuristic Agent Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/ivHeaderLogo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/joker_logo"
            android:scaleType="fitCenter"
            android:contentDescription="Joker Logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JOKER AI"
                android:textColor="#FF1E44"
                android:textSize="20sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEURAL CORE // ACTIVE"
                android:textColor="#555566"
                android:textSize="11sp"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLiveBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● ONLINE"
            android:textColor="#00FF66"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center Stage: Glowing 3D Particle Orb -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="6dp"
        android:paddingBottom="10dp">

        <com.joker.ai.JokerOrbView
            android:id="@+id/jokerOrb"
            android:layout_width="220dp"
            android:layout_height="220dp" />

        <TextView
            android:id="@+id/tvOrbStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="STANDBY // TAP MIC TO SPEAK"
            android:textColor="#888899"
            android:textSize="12sp"
            android:letterSpacing="0.06"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Translucent Chat Display Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#101016"
        android:orientation="vertical"
        android:padding="12dp">

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <TextView
                android:id="@+id/tvChat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Joker AI: Neural link connected. Ready for commands.\n"
                android:textColor="#DDDDDD"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp" />
        </ScrollView>
    </LinearLayout>

    <!-- Bottom Floating Dock: Input, Mic, and Send -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="10dp">

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Ask Joker or tap mic..."
            android:textColorHint="#555566"
            android:textColor="#FFFFFF"
            android:background="#15151F"
            android:paddingHorizontal="14dp"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_mic"
            android:scaleType="centerInside"
            android:background="#200B13"
            android:contentDescription="Voice Input" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="SEND"
            android:backgroundTint="#FF1E44"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
